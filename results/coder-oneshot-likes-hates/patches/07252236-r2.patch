+-- ============================================================================
+-- Helper functions for trait matching
+-- ============================================================================
+
+-- Match a keyword against a string using case-insensitive plain substring search.
+-- Returns true if keyword is found, false otherwise.
+-- Uses string.find with plain mode (no Lua patterns) for safety.
+local function MatchKeyword(keyword, text)
+    if not keyword or not text then return false end
+    if #keyword == 0 or #text == 0 then return false end
+    return string.find(string.lower(text), string.lower(keyword), 1, true) ~= nil
+end
+
+-- Check if the current zone/subzone matches any place trait keywords.
+-- Returns "Likes", "Hates", or nil if no match.
+local function CheckPlaceTraits(personality)
+    local realZone = GetRealZoneText() or ""
+    local subZone = GetSubZoneText() or ""
+
+    -- Check hates first (deterministic win when both match)
+    if personality.hates and personality.hates.places then
+        for _, keyword in ipairs(personality.hates.places) do
+            if MatchKeyword(keyword, realZone) or MatchKeyword(keyword, subZone) then
+                return "Hates"
+            end
+        end
+    end
+
+    -- Check likes
+    if personality.likes and personality.likes.places then
+        for _, keyword in ipairs(personality.likes.places) do
+            if MatchKeyword(keyword, realZone) or MatchKeyword(keyword, subZone) then
+                return "Likes"
+            end
+        end
+    end
+
+    return nil
+end
+
+-- Check if the current target matches any entity trait keywords.
+-- Returns "Likes", "Hates", or nil if no match.
+local function CheckEntityTraits(personality)
+    -- Safely get target name; skip if no target or empty name
+    local targetName = UnitName("target")
+    if not targetName or #targetName == 0 then
+        return nil
+    end
+
+    -- Check hates first (deterministic win when both match)
+    if personality.hates and personality.hates.entities then
+        for _, keyword in ipairs(personality.hates.entities) do
+            if MatchKeyword(keyword, targetName) then
+                return "Hates"
+            end
+        end
+    end
+
+    -- Check likes
+    if personality.likes and personality.likes.entities then
+        for _, keyword in ipairs(personality.likes.entities) do
+            if MatchKeyword(keyword, targetName) then
+                return "Likes"
+            end
+        end
+    end
+
+    return nil
+end
+
