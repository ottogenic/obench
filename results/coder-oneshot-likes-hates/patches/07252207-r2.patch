+    -- ========================================================================
+    local traitPlayed = false
+    local realZone = GetRealZoneText() or ""
+    local subZone = GetSubZoneText() or ""
+
+    -- Check Hates places first (wins over Likes)
+    if personality.hates and personality.hates.places and #personality.hates.places > 0 then
+        local matchedKeyword = MatchPlaceTrait(personality.hates.places, realZone, subZone)
+        if matchedKeyword then
+            local hateData = personality.actions["Hates"]
+            if hateData and hateData.lines and #hateData.lines > 0 then
+                local chance = 1.0
+                if not Loudmouth.DebugMode then
+                    local weight = hateData.weight or 1.0
+                    chance = weight
+                end
+                if math.random() <= chance then
+                    local line = hateData.lines[math.random(#hateData.lines)]
+                    SafeSendChat(line, "SAY")
+                    traitPlayed = true
+                    Loudmouth.Cooldowns["Hates"] = now
+                end
+            end
+        end
+    end
+
+    -- Check Likes places (only if no Hates match)
+    if not traitPlayed and personality.likes and personality.likes.places and #personality.likes.places > 0 then
+        local matchedKeyword = MatchPlaceTrait(personality.likes.places, realZone, subZone)
+        if matchedKeyword then
+            local likeData = personality.actions["Likes"]
+            if likeData and likeData.lines and #likeData.lines > 0 then
+                local chance = 1.0
+                if not Loudmouth.DebugMode then
+                    local weight = likeData.weight or 1.0
+                    chance = weight
+                end
+                if math.random() <= chance then
+                    local line = likeData.lines[math.random(#likeData.lines)]
+                    SafeSendChat(line, "SAY")
+                    traitPlayed = true
+                    Loudmouth.Cooldowns["Likes"] = now
+                end
+            end
+        end
+    end
+
+    if traitPlayed then
+        return
+    end
+
+    -- ========================================================================
+    -- Entity Traits (Hates/Likes) — checked before action resolution
+    -- These trigger when casting on a target that matches the keywords.
+    -- Hates wins over Likes if both match the same target.
+    -- ========================================================================
+    local entityTraitPlayed = false
+
+    -- Check Hates entities first (wins over Likes)
+    if personality.hates and personality.hates.entities and #personality.hates.entities > 0 then
+        local matchedKeyword = MatchEntityTrait(personality.hates.entities)
+        if matchedKeyword then
+            local hateData = personality.actions["Hates"]
+            if hateData and hateData.lines and #hateData.lines > 0 then
+                local chance = 1.0
+                if not Loudmouth.DebugMode then
+                    local weight = hateData.weight or 1.0
+                    chance = weight
+                end
+                if math.random() <= chance then
+                    local line = hateData.lines[math.random(#hateData.lines)]
+                    SafeSendChat(line, "SAY")
+                    entityTraitPlayed = true
+                    Loudmouth.Cooldowns["Hates"] = now
+                end
+            end
+        end
+    end
+
+    -- Check Likes entities (only if no Hates match)
+    if not entityTraitPlayed and personality.likes and personality.likes.entities and #personality.likes.entities > 0 then
+        local matchedKeyword = MatchEntityTrait(personality.likes.entities)
+        if matchedKeyword then
+            local likeData = personality.actions["Likes"]
+            if likeData and likeData.lines and #likeData.lines > 0 then
+                local chance = 1.0
+                if not Loudmouth.DebugMode then
+                    local weight = likeData.weight or 1.0
+                    chance = weight
+                end
+                if math.random() <= chance then
+                    local line = likeData.lines[math.random(#likeData.lines)]
+                    SafeSendChat(line, "SAY")
+                    entityTraitPlayed = true
+                    Loudmouth.Cooldowns["Likes"] = now
+                end
+            end
