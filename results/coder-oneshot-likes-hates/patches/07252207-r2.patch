+-- ============================================================================
+-- Trait matching helpers
+-- ============================================================================
+
+-- Case-insensitive substring match. Returns true if keyword is found in text.
+-- Uses plain string.find (no Lua patterns) for safety and performance.
+local function MatchKeyword(keyword, text)
+    if not keyword or not text then return false end
+    return string.find(string.lower(text), string.lower(keyword), 1, true) ~= nil
+end
+
+-- Check if any keyword in the list matches the zone or subzone text.
+-- Returns the matching keyword (case preserved from the list) or nil.
+local function MatchPlaceTrait(keywords, zoneText, subZoneText)
+    if not keywords or type(keywords) ~= "table" then return nil end
+    for _, keyword in ipairs(keywords) do
+        if MatchKeyword(keyword, zoneText) or MatchKeyword(keyword, subZoneText) then
+            return keyword
+        end
+    end
+    return nil
+end
+
+-- Check if any keyword in the list matches the target name.
+-- Returns the matching keyword (case preserved from the list) or nil.
+local function MatchEntityTrait(keywords)
+    if not keywords or type(keywords) ~= "table" then return nil end
+    local targetName = UnitName("target")
+    if not targetName then return nil end
+    for _, keyword in ipairs(keywords) do
+        if MatchKeyword(keyword, targetName) then
+            return keyword
+        end
+    end
+    return nil
+end
+
