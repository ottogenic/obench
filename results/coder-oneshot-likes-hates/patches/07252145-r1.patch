+-- ============================================================================
+-- Trait matching helpers
+-- ============================================================================
+
+-- Match a keyword against a text using case-insensitive plain substring search.
+-- Uses string.find with plain mode (no Lua patterns).
+-- Returns true if keyword is found, false otherwise.
+local function matchKeyword(text, keyword)
+    if not text or not keyword or text == "" or keyword == "" then
+        return false
+    end
+    return string.find(string.lower(text), string.lower(keyword), 1, true) ~= nil
+end
+
+-- Check if the current zone or subzone matches any keyword in a trait array.
+-- Returns the matched keyword or nil.
+local function matchPlaceTrait(keywords)
+    if not keywords or #keywords == 0 then
+        return nil
+    end
+    local realZone = GetRealZoneText() or ""
+    local subZone = GetSubZoneText() or ""
+    for _, keyword in ipairs(keywords) do
+        if matchKeyword(realZone, keyword) or matchKeyword(subZone, keyword) then
+            return keyword
+        end
+    end
+    return nil
+end
+
+-- Get the current target name for trait matching.
+-- Returns UnitName("target") or nil if no target exists.
+local function getTargetName()
+    if UnitExists("target") then
+        local name = UnitName("target")
+        if name and name ~= "" then
+            return name
+        end
+    end
+    return nil
+end
+
+-- Check if the current target matches any keyword in a trait array.
+-- Returns the matched keyword or nil.
+local function matchEntityTrait(keywords)
+    if not keywords or #keywords == 0 then
+        return nil
+    end
+    local targetName = getTargetName()
+    if not targetName then
+        return nil
+    end
+    for _, keyword in ipairs(keywords) do
+        if matchKeyword(targetName, keyword) then
+            return keyword
+        end
+    end
+    return nil
+end
+
