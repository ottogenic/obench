+-- Select a random line from a weighted bucket, respecting cooldown.
+-- Returns the selected line string, or nil if no line should play.
+local function GetWeightedLine(personality, actionKey, now)
+    local actionData = personality.actions and personality.actions[actionKey]
+    if not actionData or not actionData.lines or #actionData.lines == 0 then
+        return nil
