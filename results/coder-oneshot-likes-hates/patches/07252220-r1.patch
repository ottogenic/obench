+-- ============================================================================
+-- Traits matching helpers
+-- ============================================================================
+
+-- Check if any keyword from a keyword array is contained in a subject string.
+-- Returns true if a match is found, false otherwise.
+-- Uses case-insensitive plain substring matching (string.find with no patterns).
+local function ContainsKeyword(subject, keywords)
+    if not subject or subject == "" then return false end
+    if not keywords or type(keywords) ~= "table" then return false end
+    local lowerSubject = string.lower(subject)
+    for _, keyword in ipairs(keywords) do
+        if type(keyword) == "string" and keyword ~= "" then
+            if string.find(lowerSubject, string.lower(keyword), 1, true) then
+                return true
+            end
+        end
+    end
+    return false
+end
+
+-- Check if the current zone matches any place keywords from traits.
+-- Returns "Likes", "Hates", or nil.
+local function MatchPlaceTraits(personality)
+    if not personality then return nil end
+    local realZone = GetRealZoneText() or ""
+    local subZone = GetSubZoneText() or ""
+
+    -- Check hates first (hates wins over likes)
+    if personality.hates and personality.hates.places then
+        if ContainsKeyword(realZone, personality.hates.places) or
+           ContainsKeyword(subZone, personality.hates.places) then
+            return "Hates"
+        end
+    end
+
+    -- Check likes
+    if personality.likes and personality.likes.places then
+        if ContainsKeyword(realZone, personality.likes.places) or
+           ContainsKeyword(subZone, personality.likes.places) then
+            return "Likes"
+        end
+    end
+
+    return nil
+end
+
+-- Check if the current target matches any entity keywords from traits.
+-- Returns "Likes", "Hates", or nil.
+local function MatchEntityTraits(personality)
+    if not personality then return nil end
+    local targetName = UnitName("target")
+    if not targetName or targetName == "" then return nil end
+
+    -- Check hates first (hates wins over likes)
+    if personality.hates and personality.hates.entities then
+        if ContainsKeyword(targetName, personality.hates.entities) then
+            return "Hates"
+        end
+    end
+
+    -- Check likes
+    if personality.likes and personality.likes.entities then
+        if ContainsKeyword(targetName, personality.likes.entities) then
+            return "Likes"
+        end
+    end
+
+    return nil
+end
