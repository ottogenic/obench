+-- ============================================================================
+-- Trait matching helpers
+-- ============================================================================
+
+-- Check if any keyword from a list is contained in a string (case-insensitive, plain substring)
+local function MatchKeywords(keywords, text)
+    if not keywords or not text then return false end
+    local lowerText = string.lower(text)
+    for _, keyword in ipairs(keywords) do
+        if string.find(lowerText, string.lower(keyword), 1, true) then
+            return true
+        end
+    end
+    return false
+end
+
