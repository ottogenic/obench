+
+-- Check if any keyword from an array is contained in a target string
+-- using case-insensitive plain substring matching.
+-- Returns true if a match is found, false otherwise.
+local function containsKeyword(target, keywords)
+    if not target or not keywords or #keywords == 0 then
+        return false
+    end
+    local lowerTarget = string.lower(target)
+    for _, keyword in ipairs(keywords) do
+        if type(keyword) == "string" and keyword ~= "" then
+            if string.find(lowerTarget, string.lower(keyword), 1, true) then
+                return true
+            end
+        end
+    end
+    return false
+end
+
+-- Get the current target name safely.
+-- Returns the name string or nil if no target exists.
+local function GetTargetName()
+    if UnitName("target") then
+        return UnitName("target")
+    end
+    return nil
+end
+
