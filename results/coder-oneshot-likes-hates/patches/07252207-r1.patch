+-- ============================================================================
+-- Trait matching helpers
+-- ============================================================================
+
+-- Match a keyword against a subject string using case-insensitive plain substring search.
+-- Uses string.find with plain mode (no Lua patterns).
+-- Returns true if keyword is found, false otherwise.
+local function MatchKeyword(keyword, subject)
+    if not keyword or not subject then return false end
+    return string.find(string.lower(subject), string.lower(keyword), 1, true) ~= nil
+end
+
+-- Check if the current zone or subzone matches any place keywords in a trait table.
+-- Returns the matched keyword or nil.
+local function MatchPlaceTrait(keywords)
+    if not keywords or type(keywords) ~= "table" then return nil end
+    local zone = GetRealZoneText() or ""
+    local subzone = GetSubZoneText() or ""
+    for _, keyword in ipairs(keywords) do
+        if MatchKeyword(keyword, zone) or MatchKeyword(keyword, subzone) then
+            return keyword
+        end
+    end
+    return nil
+end
+
+-- Check if the current target matches any entity keywords in a trait table.
+-- Returns the matched keyword or nil.
+local function MatchEntityTrait(keywords)
+    if not keywords or type(keywords) ~= "table" then return nil end
+    local targetName = UnitName("target")
+    if not targetName then return nil end
+    for _, keyword in ipairs(keywords) do
+        if MatchKeyword(keyword, targetName) then
+            return keyword
+        end
+    end
+    return nil
+end
+
