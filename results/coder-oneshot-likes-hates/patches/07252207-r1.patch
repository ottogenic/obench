+-- ============================================================================
+-- Trait matching helpers
+-- ============================================================================
+
+-- Case-insensitive plain substring match. Uses string.find with plain mode
+-- (no Lua patterns) for safety and performance.
+local function KeywordMatches(text, keywords)
+    if not text or text == "" then return false end
+    if not keywords or type(keywords) ~= "table" then return false end
+
+    local textLower = string.lower(text)
+    for _, keyword in ipairs(keywords) do
+        if keyword and string.find(textLower, string.lower(keyword), 1, true) then
+            return true
+        end
+    end
+    return false
+end
+
+-- Select a random line from a weighted action bucket.
+-- Returns the line string or nil if no lines available.
+local function GetWeightedLine(actionData)
+    if not actionData or not actionData.lines or #actionData.lines == 0 then
+        return nil
+    end
+    return actionData.lines[math.random(#actionData.lines)]
+end
