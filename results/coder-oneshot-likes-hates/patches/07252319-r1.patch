+-- ============================================================================
+-- Trait matching helpers
+-- ============================================================================
+
+-- Match a keyword against a string using case-insensitive plain substring search.
+-- Uses string.find with plain mode (no Lua patterns) for safety and performance.
+-- Returns true if keyword is found, false otherwise.
+local function MatchKeyword(keyword, text)
+    if not keyword or not text then return false end
+    if type(keyword) ~= "string" or type(text) ~= "string" then return false end
+    if #keyword == 0 or #text == 0 then return false end
+    return string.find(string.lower(text), string.lower(keyword), 1, true) ~= nil
+end
+
+-- Check if the current zone or subzone matches any place keywords in a traits table.
+-- Returns the matched keyword string if found, nil otherwise.
+local function MatchPlaceTraits(traitsTable)
+    if not traitsTable then return nil end
+    local realZone = GetRealZoneText() or ""
+    local subZone = GetSubZoneText() or ""
+
+    -- Check places array
+    if traitsTable.places and #traitsTable.places > 0 then
+        for _, keyword in ipairs(traitsTable.places) do
+            if MatchKeyword(keyword, realZone) or MatchKeyword(keyword, subZone) then
+                return keyword
+            end
+        end
+    end
+
+    return nil
+end
+
+-- Check if the current target name matches any entity keywords in a traits table.
+-- Returns the matched keyword string if found, nil otherwise.
+local function MatchEntityTraits(traitsTable)
+    if not traitsTable then return nil end
+
+    -- Get target name safely
+    local targetName = UnitName("target")
+    if not targetName or type(targetName) ~= "string" or #targetName == 0 then
+        return nil
+    end
+
+    -- Check entities array
+    if traitsTable.entities and #traitsTable.entities > 0 then
+        for _, keyword in ipairs(traitsTable.entities) do
+            if MatchKeyword(keyword, targetName) then
+                return keyword
+            end
+        end
+    end
+
+    return nil
+end
