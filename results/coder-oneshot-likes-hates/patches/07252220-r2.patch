 Loudmouth.GetRace = function() return UnitRace("player") end
 Loudmouth.GetClass = function() return UnitClass("player") end
 
+-- ============================================================================
+-- Trait matching helpers
+-- ============================================================================
+
+-- Match a keyword against a string using case-insensitive plain substring search.
+-- Returns true if keyword is found in text, false otherwise.
+local function MatchKeyword(keyword, text)
+    if not keyword or not text then return false end
+    return string.find(string.lower(text), string.lower(keyword), 1, true) ~= nil
+end
+
+-- Check if the current zone matches any place keyword in a keywords array.
+-- Returns the matching keyword or nil.
+local function MatchPlaceKeywords(keywords)
+    if not keywords or type(keywords) ~= "table" then return nil end
+    local zone = GetRealZoneText() or ""
+    local subzone = GetSubZoneText() or ""
+    for _, keyword in ipairs(keywords) do
+        if MatchKeyword(keyword, zone) or MatchKeyword(keyword, subzone) then
+            return keyword
+        end
+    end
+    return nil
+end
+
+-- Check if the current target matches any entity keyword in a keywords array.
+-- Returns the matching keyword or nil.
+local function MatchEntityKeywords(keywords)
+    if not keywords or type(keywords) ~= "table" then return nil end
+    local targetName = UnitName("target")
+    if not targetName then return nil end
+    for _, keyword in ipairs(keywords) do
+        if MatchKeyword(keyword, targetName) then
+            return keyword
+        end
+    end
+    return nil
+end
+
