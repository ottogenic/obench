diff --git a/Interface/AddOns/Loudmouth/Loudmouth.lua b/Interface/AddOns/Loudmouth/Loudmouth.lua
index b1e1197..4aa1f6b 100644
--- a/Interface/AddOns/Loudmouth/Loudmouth.lua
+++ b/Interface/AddOns/Loudmouth/Loudmouth.lua
@@ -444,6 +444,52 @@ function Loudmouth.Trigger(action)
         end
 
         -- No comment was found, but we still consumed the pending flag.
+        -- Now check for trait-based place reactions (hated then liked).
+        -- Trait place reactions are resolved here because they are location-based
+        -- and should be prioritized over entity reactions and action rolls.
+        if not played and personality.likes and personality.hates then
+            -- Check hated places first (priority over liked)
+            local hatedPlaceMatched = false
+            if personality.hates.places and #personality.hates.places > 0 then
+                for _, keyword in ipairs(personality.hates.places) do
+                    if string.find(string.lower(realZone), string.lower(keyword), 1, true) or
+                       string.find(string.lower(subZone), string.lower(keyword), 1, true) then
+                        -- Found a hated place keyword match
+                        local hateData = personality.actions["Hates"]
+                        if hateData and hateData.lines and #hateData.lines > 0 then
+                            local line = hateData.lines[math.random(#hateData.lines)]
+                            SafeSendChat(line, "SAY")
+                            played = true
+                            break
+                        end
+                    end
+                end
+            end
+
+            -- Check liked places if no hated place matched
+            if not played and personality.likes.places and #personality.likes.places > 0 then
+                for _, keyword in ipairs(personality.likes.places) do
+                    if string.find(string.lower(realZone), string.lower(keyword), 1, true) or
+                       string.find(string.lower(subZone), string.lower(keyword), 1, true) then
+                        -- Found a liked place keyword match
+                        local likeData = personality.actions["Likes"]
+                        if likeData and likeData.lines and #likeData.lines > 0 then
+                            local line = likeData.lines[math.random(#likeData.lines)]
+                            SafeSendChat(line, "SAY")
+                            played = true
+                            break
+                        end
+                    end
+                end
+            end
+        end
+
+        if played then
+            Loudmouth.PendingZoneComment = false
+            return
+        end
+
+        -- Still no comment was found, but we still consumed the pending flag.
         Loudmouth.PendingZoneComment = false
     end
 
